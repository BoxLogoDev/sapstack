{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "noEmit": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["server.ts", "cli.ts", "registry.ts", "version.ts", "generate-manifest.ts", "../packages/runtime/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
