{
  "$schema": "https://schema.modelcontextprotocol.io/server/v1",
  "name": "sapstack",
  "version": "2.4.0",
  "description": "SAP operations advisory and Evidence Loop — 23 tools, 12 prompts, 9 resources/templates",
