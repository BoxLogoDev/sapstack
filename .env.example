# sapstack SAP 접속 프로필 템플릿
# 복사: cp .env.example ~/.sapstack/.env
# setup.sh / setup.ps1 의 [3/5] 단계 또는 Desktop 앱(설정 > SAP 접속)이 자동 생성해 주기도 함.
# ⚠ 비밀번호 평문 저장이므로 조회 전용 계정을 권장합니다. 파일 공유 금지.

# ADT URL — SAP GUI: SMICM > Goto > Services 의 HTTP(S) 포트
# 내부 호스트명이 DNS 에 없으면 IP 직접 입력 (예: https://10.x.x.x:44300)
SAP_URL=https://your-sap-host:44300
SAP_USER=YOUR_USERNAME
SAP_PASSWORD=YOUR_PASSWORD
SAP_CLIENT=100
SAP_LANGUAGE=KO

# 사설 인증서(내부 호스트명용 self-signed) 환경이면 true
SAP_INSECURE=true

# AI 브리지(vsp)가 SAP 를 수정하지 못하게 잠금 — 반드시 true 유지 권장
SAP_READ_ONLY=true
