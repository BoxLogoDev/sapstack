@echo off
set "SAPSTACK_DESKTOP_BUN_BIN=%SAPSTACK_DESKTOP_BUN%"
if "%SAPSTACK_DESKTOP_BUN_BIN%"=="" set "SAPSTACK_DESKTOP_BUN_BIN=bun"
set "SAPSTACK_DESKTOP_COMMANDS_BIN=%SAPSTACK_DESKTOP_COMMANDS_ENTRY%"
if "%SAPSTACK_DESKTOP_COMMANDS_BIN%"=="" set "SAPSTACK_DESKTOP_COMMANDS_BIN=%SAPSTACK_DESKTOP_CLI_ENTRY%"
if "%SAPSTACK_DESKTOP_CLI_JSON_ONLY%"=="" set "SAPSTACK_DESKTOP_CLI_JSON_ONLY=1"
"%SAPSTACK_DESKTOP_BUN_BIN%" run "%SAPSTACK_DESKTOP_COMMANDS_BIN%" %*
